# ===== 复制为 .env 后按需填写，留空的功能会自动跳过/降级 =====

# 智谱 GLM（免费，https://open.bigmodel.cn 注册后创建 API Key）
# 不填则无中文点评，简介回退为英文原文
ZHIPU_API_KEY=
ZHIPU_MODEL=glm-4-flash

# WxPusher（https://wxpusher.zjiecode.com 创建应用后获得）
WXPUSHER_APP_TOKEN=
# 你的 UID（关注应用后，在「用户管理」里可以看到）
WXPUSHER_UID=
# 也可用主题 ID 逗号分隔（与 UID 二选一或同用）
WXPUSHER_TOPIC_IDS=

# Server酱（https://sct.ftqq.com 微信扫码登录后获得 SendKey）
SCT_SENDKEY=

# 邮箱推送（QQ 邮箱：设置→账户→开启 SMTP→生成授权码，授权码填在 SMTP_PASS）
SMTP_HOST=smtp.qq.com
SMTP_USER=
SMTP_PASS=
SMTP_TO=

# 榜单条数
TOP_N=15
